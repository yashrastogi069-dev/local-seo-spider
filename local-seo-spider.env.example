# Local SEO Spider configuration. The first run copies this safe template to .env.
# Keep .env local; .gitignore prevents it from being committed.
SPIDER_DATA_DIR=./data
SPIDER_USER_AGENT=LocalSEOSpider/0.1 (+local-authorized-audit)
SPIDER_DEFAULT_URL_CAP=500
SPIDER_MAX_URL_CAP=10000
SPIDER_DEFAULT_DELAY_SECONDS=0.35
SPIDER_REQUEST_TIMEOUT_SECONDS=20
SPIDER_RENDER_TIMEOUT_SECONDS=25000
SPIDER_MAX_REDIRECTS=8
SPIDER_MAX_DOCUMENT_BYTES=2097152
SPIDER_MAX_REQUEST_RETRIES=2
SPIDER_RETRY_BACKOFF_SECONDS=0.5
SPIDER_MAX_CONCURRENT_CRAWLS=1
SPIDER_RENDER_ENABLED=true
