# Local SEO Spider configuration. The first run copies this safe template to .env.
# Keep .env local; .gitignore prevents it from being committed.
SPIDER_DATA_DIR=./data
SPIDER_USER_AGENT=LocalSEOSpider/0.1 (+local-authorized-audit)
SPIDER_DEFAULT_URL_CAP=500
SPIDER_MAX_URL_CAP=10000
SPIDER_DEFAULT_DELAY_SECONDS=0.35
SPIDER_REQUEST_TIMEOUT_SECONDS=20
SPIDER_RENDER_TIMEOUT_SECONDS=25000
SPIDER_MAX_REDIRECTS=8
SPIDER_MAX_DOCUMENT_BYTES=2097152
SPIDER_MAX_REQUEST_RETRIES=2
SPIDER_RETRY_BACKOFF_SECONDS=0.5
SPIDER_MAX_CONCURRENT_CRAWLS=1
SPIDER_RENDER_ENABLED=true
# Optional validated target-field profile. Copy extraction-profile.example.json and set this path.
# SPIDER_EXTRACTION_PROFILE_PATH=./extraction-profile.example.json
# serial is safest with Playwright; async/thread/process are bounded static-work modes.
SPIDER_CRAWL_EXECUTOR_MODE=serial
SPIDER_ASYNC_CONCURRENCY=8
SPIDER_THREAD_WORKERS=4
SPIDER_PROCESS_WORKERS=2
# Real local semantic embeddings. Set to hash only when explicitly choosing lexical/offline fallback.
SPIDER_EMBEDDING_PROVIDER=sentence-transformers
SPIDER_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
SPIDER_EMBEDDING_DIMENSION=384
